# =============================================================================
# AEGIS — Master environment template
# =============================================================================
# Copy this file into the two places that actually read it:
#
#   cp .env.example backend/.env
#   cp .env.example web/.env.local
#
# Then fill in the blanks below. Values marked [SECRET] must NEVER appear in
# web/.env.local — anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE  — already provisioned for you (project "Aegis", ap-south-1)
# -----------------------------------------------------------------------------
# These two are safe to expose publicly; RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://amypafeuuqahdzsnbnte.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Ga37s2lL2ieghkXpCCL3zA_DYcI8m7T

# Backend-only mirror of the same two values (FastAPI doesn't use NEXT_PUBLIC_).
SUPABASE_URL=https://amypafeuuqahdzsnbnte.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Ga37s2lL2ieghkXpCCL3zA_DYcI8m7T

# [SECRET] Bypasses every RLS policy. Backend only — never in web/.env.local.
# Get it: Supabase Dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# [SECRET] Used to verify the JWTs your frontend sends to FastAPI.
# Get it: Supabase Dashboard -> Project Settings -> API Keys -> JWT Settings
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
# 2. OPENAI  — the only AI vendor Aegis needs
# -----------------------------------------------------------------------------
# [SECRET] Backend only. The browser never sees this key: it reaches the
# Realtime API through the FastAPI SDP proxy, so the key stays server-side.
# Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Model selection (see README "Which models does Aegis use?") -------------
# Voice negotiation over WebRTC. GA name; older previews also work.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Voice of the arbitrator. Options: alloy, ash, ballad, coral, echo, sage, verse
OPENAI_REALTIME_VOICE=ash

# Work-proof image verification (must be a vision-capable model).
OPENAI_VISION_MODEL=gpt-4o

# The three jury agents (Buyer's Advocate, Seller's Advocate, Magistrate).
OPENAI_JURY_MODEL=gpt-4o

# Trust Reel copywriting — small and fast is fine here.
OPENAI_REEL_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# 3. WIRING
# -----------------------------------------------------------------------------
# Where the browser reaches FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where FastAPI accepts browser requests from (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Public origin of the web app; used to build shareable Trust Reel links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 4. RISK ENGINE TUNING  (safe defaults — override only if the demo needs it)
# -----------------------------------------------------------------------------
# Cumulative risk score at which Aegis refuses to lock funds at all.
AEGIS_RISK_HALT_THRESHOLD=70

# Vocal Entropy Trap: a genuine human repeats the challenge phrase within this
# window. Cloned-voice pipelines need longer to re-synthesize on a hard
# semantic pivot, and blow past it.
AEGIS_ENTROPY_MAX_LATENCY_MS=4000

# Minimum phonetic similarity (0..1) for a challenge response to count.
AEGIS_ENTROPY_MIN_MATCH=0.72

# Largest contract Aegis will lock without a human review step (in cents).
AEGIS_MAX_AUTO_LOCK_CENTS=5000000
